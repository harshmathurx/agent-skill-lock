{
  "name": "agent-skill-lock",
  "version": "0.1.0",
  "description": "Lock and check repo-local agent skills, MCP servers, and tool permissions.",
  "type": "module",
  "license": "MIT",
  "author": "Harsh Mathur",
  "repository": { "type": "git", "url": "git+https://github.com/harshmathurx/agent-skill-lock.git" },
  "homepage": "https://github.com/harshmathurx/agent-skill-lock#readme",
  "bugs": { "url": "https://github.com/harshmathurx/agent-skill-lock/issues" },
  "keywords": ["agent", "mcp", "claude", "codex", "cursor", "lockfile", "security", "ci"],
  "bin": { "agent-skill-lock": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "docs", "examples", "action.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.14"
  },
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.20.0"
}
